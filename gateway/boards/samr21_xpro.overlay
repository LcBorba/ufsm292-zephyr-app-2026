/* PA28 is free again: the Ethernet board is on EXT3, which has no reset line. */

 / {
 	example_sensor: example-sensor {
 		compatible = "zephyr,example-sensor";
 		input-gpios = <&porta 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
 	};

	blink_led: blink-led {
		compatible = "blink-gpio-led";
		led-gpios = <&porta 19 GPIO_ACTIVE_LOW>;
		blink-period-ms = <1000>;
	};
};

/* Ethernet1 on EXT3: SPI data/clock shared with EXT1, but CS is PA14 and
 * EXT3 has no IRQ or reset lines. The driver polls without an interrupt
 * and relies on power-on reset when reset-gpios is absent. */
&sercom5 {
	status = "okay";
	compatible = "atmel,sam0-spi";
	#address-cells = <1>;
	#size-cells = <0>;

	cs-gpios = <&porta 14 GPIO_ACTIVE_LOW>;

	eth_ksz8851: ethernet@0 {
		compatible = "microchip,ksz8851snl";
		reg = <0>;
		spi-max-frequency = <1000000>;
		local-mac-address = [02 04 A3 12 34 56];
		status = "okay";
	};
};